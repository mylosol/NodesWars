{
  "name": "nodeswars/api",
  "description": "Nodes Wars authoritative backend",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-sodium": "*",
    "slim/slim": "^4.13",
    "slim/psr7": "^1.6",
    "php-di/php-di": "^7.0",
    "monolog/monolog": "^3.7",
    "vlucas/phpdotenv": "^5.6",
    "sentry/sentry": "^4.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.3",
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.62"
  },
  "autoload": {
    "psr-4": {
      "NodesWars\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NodesWars\\Api\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix"
  }
}
