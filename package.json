{
  "name": "nodes-wars",
  "private": true,
  "version": "0.0.0",
  "description": "Nodes Wars monorepo root",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @nodeswars/pwa dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "tsc -b --pretty",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.5",
    "typescript": "7.0.2"
  }
}
